# =======================================================
# Arquivo de exemplo de variaveis de ambiente do SOEC
# Copie este arquivo para ".env" e preencha com seus dados
# NUNCA suba o arquivo ".env" real para o github (coloque no .gitignore)
# =======================================================

# Porta em que o servidor Express vai rodar
PORT=3000

# Dados de conexao com o PostgreSQL
DB_HOST=localhost
DB_PORT=
DB_USER=postgres
DB_PASSWORD=
DB_NAME=soec
# Use true apenas se o servidor PostgreSQL exigir conexao SSL (ex.: producao).
DB_SSL=false

# Segredo usado para assinar o cookie de sessao (troque por uma string aleatoria grande)
SESSION_SECRET=

# Obrigatória somente quando algum evento exigir CPF.
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde-a em cofre de segredos e mantenha backups seguros; trocar a chave impede descriptografar CPFs já salvos.
CPF_CRYPTO_KEY=
# Opcional: chave HMAC separada para unicidade de CPF; se vazia, CPF_CRYPTO_KEY também é usada.
CPF_HASH_KEY=

# Ambiente da aplicacao (development | production)
NODE_ENV=development
