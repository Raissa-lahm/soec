# =======================================================
# Arquivo de exemplo de variaveis de ambiente do SOEC
# Copie este arquivo para ".env" e preencha com seus dados
# NUNCA suba o arquivo ".env" real para o github (coloque no .gitignore)
# =======================================================

# Porta em que o servidor Express vai rodar
PORT=3000

# Dados de conexao com o PostgreSQL
DB_HOST=localhost
DB_PORT=
DB_USER=postgres
DB_PASSWORD=
DB_NAME=soec
# Use true apenas se o servidor PostgreSQL exigir conexao SSL (ex.: producao).
DB_SSL=false

# Segredo usado para assinar o cookie de sessao (troque por uma string aleatoria grande)
SESSION_SECRET=

# Ambiente da aplicacao (development | production)
NODE_ENV=development
