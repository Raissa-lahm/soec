<!DOCTYPE html>
<html lang="pt-br">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Primeiro acesso - SOEC</title><link rel="stylesheet" href="/css/style.css"></head>
<body><div class="tela-login"><div class="login-cartao">
    <h1>SOEC</h1><p class="subtitulo">Primeiro acesso de professores e equipe</p>
    <p>Informe os dados e o código de ativação fornecido pela gestão.</p>
    <% if (erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
    <form action="/primeiro-acesso" method="POST" autocomplete="off">
        <div class="campo"><label for="matricula">Matrícula</label><input id="matricula" name="matricula" value="<%= matricula || '' %>" required autofocus></div>
        <div class="campo"><label for="email">E-mail cadastrado</label><input type="email" id="email" name="email" value="<%= email || '' %>" required></div>
        <div class="campo"><label for="codigo">Código de ativação</label><input id="codigo" name="codigo" maxlength="9" required></div>
        <div class="campo"><label for="senha">Nova senha (mínimo 10 caracteres)</label><input type="password" id="senha" name="senha" minlength="10" maxlength="72" required></div>
        <div class="campo"><label for="confirmarSenha">Confirmar senha</label><input type="password" id="confirmarSenha" name="confirmarSenha" minlength="10" maxlength="72" required></div>
        <button type="submit" class="botao botao-primario" style="width:100%">Ativar conta</button>
    </form>
    <p style="text-align:center;margin-top:1rem"><a href="/login">Voltar ao login</a></p>
</div></div></body></html>
