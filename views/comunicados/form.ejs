<% var titulo = comunicado ? 'Editar comunicado' : 'Novo comunicado' %>
<%- include('../partials/header') %>

<div class="titulo-pagina"><h1><%= titulo %></h1></div>

<div class="form-cartao">
    <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alerta alerta-erro"><%= erro %></div>
    <% } %>
    <form action="<%= acao %>" method="POST">
        <div class="campo">
            <label for="titulo">Titulo *</label>
            <input type="text" id="titulo" name="titulo" value="<%= comunicado ? comunicado.titulo : '' %>" required>
        </div>
        <div class="campo">
            <label for="descricao">Descricao</label>
            <textarea id="descricao" name="descricao" rows="6"><%= comunicado ? (comunicado.descricao || '') : '' %></textarea>
        </div>
        <div class="acoes">
            <button type="submit" class="botao botao-primario">Salvar</button>
            <a href="/comunicados" class="botao botao-secundario">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
