<!DOCTYPE html>
<html lang="pt-br"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Trocar senha - SOEC</title><link rel="stylesheet" href="/css/style.css"></head>
<body><div class="tela-login"><div class="login-cartao"><h1>SOEC</h1><p class="subtitulo">Troca obrigatória de senha</p>
<% if (erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
<form action="/trocar-senha" method="POST" autocomplete="off">
<div class="campo"><label for="senha">Nova senha</label><input type="password" id="senha" name="senha" minlength="<%= usuarioLogado.perfil === 'ALUNO' ? 7 : 10 %>" maxlength="72" required></div>
<div class="campo"><label for="confirmarSenha">Confirmar senha</label><input type="password" id="confirmarSenha" name="confirmarSenha" minlength="<%= usuarioLogado.perfil === 'ALUNO' ? 7 : 10 %>" maxlength="72" required></div>
<button type="submit" class="botao botao-primario" style="width:100%">Salvar nova senha</button></form>
<form action="/logout" method="POST" style="text-align:center;margin-top:1rem"><button class="botao botao-secundario" type="submit">Sair</button></form>
</div></div></body></html>
