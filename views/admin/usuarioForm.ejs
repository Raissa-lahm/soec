<% var titulo = usuario ? 'Editar usuário' : 'Novo usuário' %>
<%- include('../partials/header') %>

<div class="titulo-pagina"><h1><%= titulo %></h1></div>

<div class="form-cartao">
    <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alerta alerta-erro"><%= erro %></div>
    <% } %>

    <form action="<%= acao %>" method="POST">
        <div class="campo">
            <label for="nome">Nome completo *</label>
            <input type="text" id="nome" name="nome" value="<%= usuario ? usuario.nome : '' %>" required>
        </div>

        <div class="linha-form">
            <div class="campo">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" value="<%= usuario ? usuario.email : '' %>" required>
            </div>
            <div class="campo">
                <label for="matricula">Matrícula *</label>
                <input type="text" id="matricula" name="matricula" value="<%= usuario ? usuario.matricula : '' %>" required>
            </div>
        </div>

        <div class="linha-form">
            <div class="campo">
                <label for="perfil">Perfil *</label>
                <select id="perfil" name="perfil" required>
                    <option value="">Selecione...</option>
                    <% perfis.forEach(p => { %>
                        <option value="<%= p %>" <%= usuario && usuario.perfil === p ? 'selected' : '' %>><%= p %></option>
                    <% }) %>
                </select>
            </div>
            <div class="campo"><p>Aluno recebe matrícula como senha provisória e deverá trocá-la. Perfis de equipe recebem um código de ativação.</p></div>
        </div>

        <div class="campo" id="campo-turma">
            <label for="turma_id">Turma do ano letivo <%= anoLetivo %> *</label>
            <select id="turma_id" name="turma_id">
                <option value="">Selecione a turma...</option>
                <% cursos.forEach(curso => { [1,2,3].forEach(serie => { const opcoes = turmas.filter(t => t.curso_id === curso.id && t.serie === serie); if (opcoes.length) { %>
                    <optgroup label="<%= curso.nome %> — <%= serie %>ª série">
                        <% opcoes.forEach(t => { %><option value="<%= t.id %>" <%= Number((usuario && usuario.turma_id) || 0) === t.id ? 'selected' : '' %>><%= t.codigo %></option><% }) %>
                    </optgroup>
                <% } }) }) %>
            </select>
            <% if (!turmas.length) { %><small>Cadastre turmas antes de criar alunos.</small><% } %>
        </div>
        <div class="campo" id="campo-curso">
            <label for="curso_id">Curso (opcional para equipe)</label>
            <select id="curso_id" name="curso_id"><option value="">Sem curso</option>
                <% cursos.forEach(c => { %><option value="<%= c.id %>" <%= usuario && usuario.curso === c.nome ? 'selected' : '' %>><%= c.nome %></option><% }) %>
            </select>
        </div>
        <script>
            (() => {
                const perfil = document.getElementById('perfil');
                const campoTurma = document.getElementById('campo-turma');
                const campoCurso = document.getElementById('campo-curso');
                const turma = document.getElementById('turma_id');
                const atualizar = () => {
                    const aluno = perfil.value === 'ALUNO';
                    campoTurma.hidden = !aluno;
                    campoCurso.hidden = aluno;
                    turma.required = aluno;
                };
                perfil.addEventListener('change', atualizar);
                atualizar();
            })();
        </script>

        <div class="acoes">
            <button type="submit" class="botao botao-primario">Salvar</button>
            <a href="/admin/usuarios" class="botao botao-secundario">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
