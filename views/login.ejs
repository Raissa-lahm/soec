<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - SOEC</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="tela-login">
        <div class="login-cartao">
            <h1>SOEC</h1>
            <p class="subtitulo">Sistema de Organizacao de Eventos do CIMOL</p>

            <% if (erro) { %>
                <div class="alerta alerta-erro"><%= erro %></div>
            <% } %>

            <form action="/login" method="POST">
                <div class="campo">
                    <label for="matricula">Matricula</label>
                    <input type="text" id="matricula" name="matricula" value="<%= matricula %>" required autofocus>
                </div>
                <div class="campo">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" required>
                </div>
                <button type="submit" class="botao botao-primario" style="width:100%;">Entrar</button>
            </form>
        </div>
    </div>
</body>
</html>
