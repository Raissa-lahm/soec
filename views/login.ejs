<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - SOEC</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="tela-login">
        <div class="login-cartao">
            <h1>SOEC</h1>
            <p class="subtitulo">Sistema de Organização de Eventos do CIMOL</p>

            <% if (locals.sucesso) { %>
                <div class="alerta alerta-sucesso"><%= sucesso %></div>
            <% } %>

            <% if (erro) { %>
                <div class="alerta alerta-erro"><%= erro %></div>
            <% } %>

            <form action="/login" method="POST">
                <div class="campo">
                    <label for="matricula">Matrícula</label>
                    <input type="text" id="matricula" name="matricula" value="<%= matricula %>" required autofocus>
                </div>
                <div class="campo">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" required>
                </div>
                <button type="submit" class="botao botao-primario" style="width:100%;">Entrar</button>
            </form>

            <p style="text-align:center; font-size:0.85rem;">
                Primeiro acesso? <a href="/primeiro-acesso">Crie sua senha pela matrícula</a>
            </p>
        </div>
    </div>
</body>
</html>