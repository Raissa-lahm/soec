<!-- =====================================================================
     views/partials/header.ejs
     Cabecalho com navegacao. Os links de gestao (Admin) so aparecem para
     usuarios com perfil COORDENACAO ou DIRECAO.
     ===================================================================== -->
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titulo !== 'undefined' ? titulo + ' - SOEC' : 'SOEC - Sistema de Organizacao de Eventos do CIMOL' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<% if (usuarioLogado) { %>
<header class="cabecalho">
    <div class="cabecalho-conteudo">
        <a href="/" class="marca">SOEC <span class="destaque">CIMOL</span></a>
        <nav class="nav-principal">
            <a href="/" class="<%= rotaAtual === '/' ? 'ativo' : '' %>">Inicio</a>
            <a href="/calendario" class="<%= rotaAtual && rotaAtual.startsWith('/calendario') ? 'ativo' : '' %>">Calendario</a>
            <a href="/eventos" class="<%= rotaAtual && rotaAtual.startsWith('/eventos') ? 'ativo' : '' %>">Eventos</a>
            <a href="/comunicados" class="<%= rotaAtual && rotaAtual.startsWith('/comunicados') ? 'ativo' : '' %>">Comunicados</a>
            <a href="/regulamentos" class="<%= rotaAtual && rotaAtual.startsWith('/regulamentos') ? 'ativo' : '' %>">Regulamentos</a>
            <% if (usuarioLogado.perfil === 'ALUNO') { %>
                <a href="/minhas-inscricoes" class="<%= rotaAtual && rotaAtual.startsWith('/minhas-inscricoes') ? 'ativo' : '' %>">Minhas inscricoes</a>
            <% } %>
            <% if (usuarioLogado.perfil === 'COORDENACAO' || usuarioLogado.perfil === 'DIRECAO') { %>
                <a href="/admin" class="<%= rotaAtual && rotaAtual.startsWith('/admin') ? 'ativo' : '' %>">Area administrativa</a>
            <% } %>
            <span class="usuario-tag"><%= usuarioLogado.nome %> (<%= usuarioLogado.perfil %>)</span>
            <form action="/logout" method="POST" style="display:inline;">
                <button type="submit">Sair</button>
            </form>
        </nav>
    </div>
</header>
<% } %>

<div class="container">
