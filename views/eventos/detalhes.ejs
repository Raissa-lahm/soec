<% var titulo = evento.titulo; const dinheiro = n => new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(Number(n||0)); %>
<%- include('../partials/header') %>
<div class="titulo-pagina"><div><span class="tag"><%= evento.tipo %></span><h1><%= evento.titulo %></h1></div>
<% if (['COORDENACAO','DIRECAO'].includes(usuarioLogado.perfil)) { %><div class="acoes"><a href="/eventos/<%= evento.id %>/editar" class="botao botao-secundario">Editar</a><a href="/eventos/<%= evento.id %>/inscricoes" class="botao botao-secundario">Inscrições</a><a href="/eventos/<%= evento.id %>/equipes" class="botao botao-secundario">Equipes</a><form action="/eventos/<%= evento.id %>?_method=DELETE" method="POST"><button class="botao botao-perigo">Excluir</button></form></div><% } %></div>
<div class="cartao" style="max-width:800px">
    <p><%= evento.descricao || 'Sem descrição.' %></p>
    <p><strong>Data:</strong> <%= new Date(evento.data_evento).toLocaleString('pt-BR') %><br><strong>Local:</strong> <%= evento.endereco || evento.local || 'A definir' %><br>
    <strong>Inscrição:</strong> <%= evento.status %> — <%= evento.modo_inscricao %><br>
    <strong>Valor:</strong> <%= Number(evento.valor_inscricao)===0?'Gratuito':dinheiro(evento.valor_inscricao) %><br>
    <% if(evento.transporte_ofertado){ %><strong>Transporte:</strong> <%= dinheiro(evento.valor_transporte) %><%= evento.transporte_obrigatorio?' (obrigatório)':'' %><br><% } %>
    <% if(evento.externo){ %><strong>Evento externo:</strong> <%= evento.endereco||evento.local||'Endereço a definir' %><% if(evento.ponto_encontro){ %> — ponto de encontro: <%= evento.ponto_encontro %><% } %><br><% } %>
    <% if(evento.inscricao_fim){ %><strong>Encerra em:</strong> <%= new Date(evento.inscricao_fim).toLocaleString('pt-BR') %><br><% } %>
    <% if(evento.vagas_limite>0){ %><strong>Vagas:</strong> <%= Math.max(0,evento.vagas_limite-evento.total_inscritos) %> restantes (<%= evento.total_inscritos %>/<%= evento.vagas_limite %>)<% }else{ %><strong>Vagas:</strong> Sem limite<% } %><br>
    <% if(evento.curso_nomes.length||evento.series_permitidas){ %><strong>Público:</strong> Exclusivo: <%= evento.curso_nomes.length?evento.curso_nomes.join(', '):'todos os cursos' %><%= evento.series_permitidas?` / ${evento.series_permitidas.join(', ')}ª série`:'' %><br><% } %>
    <strong>Organizado por:</strong> <%= evento.nome_criador %></p>
    <% if(usuarioLogado.perfil==='ALUNO'||usuarioLogado.perfil==='PROFESSOR'){ %>
        <% if(jaInscrito){ %><div class="alerta alerta-sucesso">Você está inscrito(a) neste evento.</div><form action="/eventos/<%= evento.id %>/cancelar-inscricao" method="POST"><button class="botao botao-perigo">Cancelar minha inscrição</button></form>
        <% }else if(elegibilidade.ok){ %><a class="botao botao-primario" href="/eventos/<%= evento.id %>/inscrever">Inscrever-se</a>
        <% }else{ %><div class="alerta alerta-aviso"><%= elegibilidade.mensagemPublica %></div><% } %>
    <% } %>
    <h3>Equipes deste evento</h3><% if(!equipes.length){ %><p>Nenhuma equipe cadastrada ainda.</p><% }else{ %><ul><% equipes.forEach(eq=>{ %><li><a href="/equipes/<%= eq.id %>"><%= eq.nome %></a> — <%= eq.total_membros %> membro(s)</li><% }) %></ul><% } %><a href="/eventos/<%= evento.id %>/equipes" class="botao botao-secundario">Ver equipes</a>
</div>
<%- include('../partials/footer') %>
