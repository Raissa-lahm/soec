<% var titulo = 'Calendario' %>
<%- include('partials/header') %>

<div class="titulo-pagina">
    <h1>Calendario institucional</h1>
</div>

<% const meses = Object.keys(eventosPorMes) %>
<% if (meses.length === 0) { %>
    <div class="cartao"><p>Nenhum evento cadastrado ainda.</p></div>
<% } else { %>
    <% meses.forEach(mes => { %>
        <div class="mes-titulo"><%= mes %></div>
        <% eventosPorMes[mes].forEach(evento => { %>
            <div class="evento-linha">
                <div>
                    <span class="tag tag-dourada"><%= evento.tipo %></span>
                    <a href="/eventos/<%= evento.id %>"><strong><%= evento.titulo %></strong></a>
                </div>
                <div>
                    <small><%= new Date(evento.data_evento).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) %> - <%= evento.local || 'Local a definir' %></small>
                </div>
            </div>
        <% }) %>
    <% }) %>
<% } %>

<%- include('partials/footer') %>
