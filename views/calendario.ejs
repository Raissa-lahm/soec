<% var titulo = 'Calendario' %>
<%- include('partials/header') %>

<div class="titulo-pagina">
    <h1>Calend&aacute;rio institucional</h1>
</div>

<section class="calendario" aria-label="Calendario institucional">
    <div class="calendario-cabecalho">
        <a class="calendario-seta" href="/calendario?mes=<%= mesAnterior.mes %>&amp;ano=<%= mesAnterior.ano %>" aria-label="Mes anterior">&#8592;</a>
        <h2><%= mesNome %></h2>
        <a class="calendario-seta" href="/calendario?mes=<%= mesProximo.mes %>&amp;ano=<%= mesProximo.ano %>" aria-label="Proximo mes">&#8594;</a>
    </div>

    <div class="calendario-grade" role="grid" aria-label="<%= mesNome %>">
        <% ['DOM', 'SEG', 'TER', 'QUA', 'QUI', 'SEX', 'SAB'].forEach(dia => { %>
            <div class="calendario-semana-dia" role="columnheader"><%= dia %></div>
        <% }) %>
        <% semanas.forEach(semana => { %>
            <% semana.forEach(celula => { %>
                <div class="calendario-celula <%= celula.estaNoMes ? '' : 'fora-do-mes' %> <%= celula.ehHoje ? 'hoje' : '' %>" role="gridcell">
                    <span class="calendario-numero"><%= celula.dia %></span>
                    <div class="calendario-eventos">
                        <% celula.eventos.forEach(evento => { %>
                            <a class="evento-calendario" href="/eventos/<%= evento.id %>" title="<%= evento.titulo %> - <%= evento.horario %>">
                                <span class="evento-horario"><%= evento.horario %></span>
                                <span class="evento-nome"><%= evento.titulo %></span>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
        <% }) %>
    </div>

    <% if (!temEventos) { %>
        <p class="calendario-vazio">Nenhum evento neste mes.</p>
    <% } %>
</section>

<%- include('partials/footer') %>
