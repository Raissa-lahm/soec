<% var titulo = regulamento ? 'Editar regulamento' : 'Novo regulamento' %>
<%- include('../partials/header') %>

<div class="titulo-pagina"><h1><%= titulo %></h1></div>

<div class="form-cartao">
    <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alerta alerta-erro"><%= erro %></div>
    <% } %>
    <form action="<%= acao %>" method="POST">
        <div class="campo">
            <label for="titulo">Titulo *</label>
            <input type="text" id="titulo" name="titulo" value="<%= regulamento ? regulamento.titulo : '' %>" required>
        </div>
        <div class="campo">
            <label for="descricao">Descricao</label>
            <textarea id="descricao" name="descricao" rows="5"><%= regulamento ? (regulamento.descricao || '') : '' %></textarea>
        </div>
        <div class="campo">
            <label for="arquivo_url">Link do arquivo (PDF)</label>
            <input type="text" id="arquivo_url" name="arquivo_url" placeholder="https://..." value="<%= regulamento ? (regulamento.arquivo_url || '') : '' %>">
        </div>
        <div class="acoes">
            <button type="submit" class="botao botao-primario">Salvar</button>
            <a href="/regulamentos" class="botao botao-secundario">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
