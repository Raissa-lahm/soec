<% var titulo = 'Nova equipe' %>
<%- include('../partials/header') %>

<div class="titulo-pagina"><h1>Nova equipe</h1></div>

<div class="form-cartao">
    <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alerta alerta-erro"><%= erro %></div>
    <% } %>
    <form action="/eventos/<%= eventoId %>/equipes" method="POST">
        <div class="campo">
            <label for="nome">Nome da equipe *</label>
            <input type="text" id="nome" name="nome" value="<%= equipe ? equipe.nome : '' %>" required>
        </div>
        <div class="campo">
            <label for="modalidade">Modalidade</label>
            <input type="text" id="modalidade" name="modalidade" placeholder="Ex: Futsal, Volei, Robotica..." value="<%= equipe ? (equipe.modalidade || '') : '' %>">
        </div>
        <div class="acoes">
            <button type="submit" class="botao botao-primario">Salvar</button>
            <a href="/eventos/<%= eventoId %>/equipes" class="botao botao-secundario">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
